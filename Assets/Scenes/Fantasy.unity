      value: 
      objectReference: {fileID: 8300000, guid: ba452b8e6860c5749af496cb8bcd4768, type: 3}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: dialogueName
      value: Everett
      objectReference: {fileID: 0}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: dialogueSprite
      value: 
      objectReference: {fileID: 21300000, guid: 0d81505725b20ca43a98877e60555ca3, type: 3}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: NpcBubbleSystem
      value: 
      objectReference: {fileID: 823901279138762503}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "Ol\xE1, jovem. Se quiser subir mais, \xE9 preciso aceitar seus medos."
      objectReference: {fileID: 0}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "V\xEA essas est\xE1tuas? S\xE3o aqueles que se negaram a assumir sua
        fraqueza."
      objectReference: {fileID: 0}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: "Seja quem tu \xE9s, o que importa \xE9 seguir em frente, n\xE3o tenha
        vergonha de suas fraquezas."
      objectReference: {fileID: 0}
    - target: {fileID: 5322663553199234063, guid: 8bcb434e00f03464a8805a1456935ef1, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "Esses cristais te dar\xE3o energia suficiente para se impulsionar novamente,
        aproveite-os!"
      objectReference: {fileID: 0}
